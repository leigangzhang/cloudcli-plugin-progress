{
  "name": "progress-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=browser --target=es2020",
    "build:server": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.23.0"
  }
}
